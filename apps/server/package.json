{
  "name": "@codex-monitor/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @codex-monitor/protocol build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "pretest": "pnpm --filter @codex-monitor/protocol build",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codex-monitor/protocol": "workspace:*",
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.19.4",
    "vitest": "^3.1.4"
  }
}
